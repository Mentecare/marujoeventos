{
  "name": "eventcore",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:database": "node scripts/test-isolated-database.mjs",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "typegen:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.19",
    "@supabase/supabase-js": "2.117.2",
    "fontkit": "2.0.4",
    "next": "15.5.29",
    "pdfkit": "0.20.2",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "sharp": "0.35.5",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261125.1",
    "@electric-sql/pglite": "0.6.0",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "0.17.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "3.6.4",
    "typescript": "^5.7.2",
    "wrangler": "4.168.0"
  },
  "type": "module",
  "overrides": {
    "next": {
      "postcss": "8.5.23"
    }
  }
}
